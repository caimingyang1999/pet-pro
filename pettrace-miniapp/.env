# =====================================================
# 单一环境变量配置文件（开发 & 生产共用）
# Vite 前端可通过 import.meta.env.xxx 读取（变量必须以 VITE_ 开头）
# =====================================================

# API 接口路径前缀
VITE_API_PREFIX=/api/v1

# -----------------------------------------------------
# 开发环境配置（npm run dev:* 时生效）
# -----------------------------------------------------
# H5 本地浏览器调试可用 http://localhost:8080
# 真机调试（微信小程序/App）时，localhost 指向手机自己会导致 ERR_CONNECTION_REFUSED，
# 请改为电脑的局域网 IP，例如：http://192.168.1.6:8080
VITE_DEV_SERVER_BASE=http://192.168.1.6:8080

# -----------------------------------------------------
# 生产环境配置（npm run build:* 时生效）
# 上线前请修改为正式服务器地址（建议使用 HTTPS）
# -----------------------------------------------------
VITE_PROD_SERVER_BASE=https://8.152.194.141:8080

# -----------------------------------------------------
# 养宠顾问模块开关
# 提审期间建议设为 false（包内硬关闭，页面显示"功能升级中"）；
# 审核通过后无需重新发版，由后端接口 GET /config/features 下发 true 远程恢复
# -----------------------------------------------------
VITE_ADVISER_ENABLED=false
