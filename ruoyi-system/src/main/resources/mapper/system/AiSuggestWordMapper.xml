<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.AiSuggestWordMapper">

    <resultMap type="com.ruoyi.system.domain.AiSuggestWord" id="AiSuggestWordResult">
        <id     property="id"          column="id"          />
        <result property="word"        column="word"        />
        <result property="petType"     column="pet_type"    />
        <result property="category"    column="category"    />
        <result property="weight"      column="weight"      />
        <result property="status"      column="status"      />
        <result property="delFlag"     column="del_flag"    />
        <result property="createTime"  column="create_time" />
        <result property="updateTime"  column="update_time" />
    </resultMap>

    <sql id="selectWordVo">
        select id, word, pet_type, category, weight, status, del_flag, create_time, update_time
        from ai_suggest_word
    </sql>

    <select id="selectActiveWords" resultMap="AiSuggestWordResult">
        <include refid="selectWordVo"/>
        where status = '1' and del_flag = '0'
        order by weight desc
    </select>

</mapper>
