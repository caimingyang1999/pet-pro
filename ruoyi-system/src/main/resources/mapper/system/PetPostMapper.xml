<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.PetPostMapper">

    <resultMap type="com.ruoyi.system.domain.PetPost" id="PetPostResult">
        <id     property="id"            column="id"             />
        <result property="userId"        column="user_id"        />
        <result property="petId"         column="pet_id"         />
        <result property="content"       column="content"        />
        <result property="images"        column="images"         />
        <result property="status"        column="status"         />
        <result property="likeCount"     column="like_count"     />
        <result property="commentCount"  column="comment_count"  />
        <result property="viewCount"     column="view_count"     />
        <result property="delFlag"       column="del_flag"       />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="userName"      column="user_name"      />
        <result property="userAvatar"    column="user_avatar"    />
        <result property="petName"       column="pet_name"       />
    </resultMap>

    <sql id="selectPostVo">
        select p.id, p.user_id, p.pet_id, p.content, p.images, p.status,
               p.like_count, p.comment_count, p.view_count, p.del_flag,
               p.create_time, p.update_time,
               u.nick_name as user_name, u.avatar as user_avatar,
               pi.name as pet_name
        from pet_post p
        left join sys_user u on p.user_id = u.user_id
        left join pet_info pi on p.pet_id = pi.id
    </sql>

    <select id="selectPostList" resultMap="PetPostResult">
        <include refid="selectPostVo"/>
        <where>
            p.del_flag = '0'
            <if test="keyword != null and keyword != ''">
                and (p.content like concat('%', #{keyword}, '%')
                     or u.nick_name like concat('%', #{keyword}, '%'))
            </if>
            <if test="userId != null">
                and p.user_id = #{userId}
            </if>
        </where>
        order by p.create_time desc
    </select>

    <!-- 管理端-动态列表（支持状态、时间范围筛选） -->
    <select id="selectPostListAdmin" resultMap="PetPostResult">
        <include refid="selectPostVo"/>
        <where>
            p.del_flag = '0'
            <if test="status != null and status != ''">
                and p.status = #{status}
            </if>
            <if test="beginTime != null">
                and p.create_time >= #{beginTime}
            </if>
            <if test="endTime != null">
                and p.create_time &lt;= #{endTime}
            </if>
        </where>
        order by p.create_time desc
    </select>

    <!-- 管理端-动态详情（关联用户和宠物信息） -->
    <select id="selectPostById" resultMap="PetPostResult">
        <include refid="selectPostVo"/>
        where p.id = #{postId}
    </select>

</mapper>
